# Neon connection string. Vercel writes this when you add the Neon integration.
DATABASE_URL=

# GitHub OAuth app for sign-in. Callback URL: <board address>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your GitHub username. Only this account can sign in.
OWNER_GITHUB_LOGIN=

# Bearer token for POST/PATCH/GET /api/bot/cards. At least 32 characters.
BOT_TOKEN=

# Optional. Target of the "← Studio" link. Example: https://hiraoku.dev
STUDIO_URL=

# Optional. Cursor API key (Cursor Dashboard → Integrations). Lets Run hand cards to a Cursor cloud agent.
CURSOR_API_KEY=
