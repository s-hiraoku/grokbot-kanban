# Neon connection string. Vercel writes this when you add the Neon integration.
DATABASE_URL=

# GitHub OAuth app for sign-in. Callback URL: <board address>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your GitHub username. You can always sign in, and only your board gets Cursor.
OWNER_GITHUB_LOGIN=

# Optional. Other GitHub usernames that may sign in, comma-separated, or * for anyone.
ALLOWED_GITHUB_LOGINS=

# Optional, old. The shared Bot token from before per-user tokens; it opens the owner's board while set.
BOT_TOKEN=

# Optional. Target of the "← Studio" link. Example: https://hiraoku.dev
STUDIO_URL=

# Optional. Cursor API key (Cursor Dashboard → Integrations). Lets Run hand cards to a Cursor cloud agent.
CURSOR_API_KEY=
