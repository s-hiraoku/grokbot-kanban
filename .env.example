# Neon connection string. Vercel writes this when you add the Neon integration.
DATABASE_URL=

# Cursor Dashboard → API Keys. Sent as Authorization: Bearer.
CURSOR_API_KEY=

# Sign-in password. At least 32 characters. Also signs the session cookie.
OWNER_PASSWORD=

# Bearer token for POST/PATCH/GET /api/bot/cards. At least 32 characters.
BOT_TOKEN=

# Bearer token Vercel Cron sends to /api/cron/tick. At least 32 characters.
CRON_SECRET=

# Optional. Target of the "← Studio" link. Example: https://hiraoku.dev
STUDIO_URL=
